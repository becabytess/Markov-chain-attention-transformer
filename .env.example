# Dynamic Semantic Memory - Environment Configuration

# 1. Embedding Provider: 'local', 'cloudflare', or 'gemini'
EMBEDDING_PROVIDER=local

# 2. Local Sentence-Transformers Model (runs 100% on your PC, 0 API key needed)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 3. Cloudflare Workers AI Settings (Optional - 10,000 free daily neurons)
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_API_TOKEN=your_api_token_here
# CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b

# 4. Google Gemini API Settings (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# GEMINI_LLM_MODEL=gemini-2.5-flash

# 5. LLM Concept Extractor: 'gemini', 'openai', 'cloudflare', or 'local'
LLM_PROVIDER=local
